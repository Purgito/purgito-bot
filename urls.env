# ── URLs y dominios públicos ───────────────────────────────────────────────────
# A diferencia de .env, este archivo NO contiene secretos y SÍ se versiona en
# git (no está en .gitignore). Para cambiar un dominio (ej: una migración
# como panel.purgito.app → purgito.app): editar, commitear, y en
# el servidor `git pull` + reiniciar el bot — sin tocar el .env manualmente.

# URL pública del dashboard web. Se muestra en /help, /setup y /settings
# para que los admins descubran el panel, y es la base de los links del panel.
PANEL_URL=https://purgito.app

# Host público donde corre el dashboard (OAuth2 de Discord + sesión). Se usa
# para armar el redirect_uri exacto: {DASHBOARD_BASE_URL}/auth/callback.
# Mismo origen que la landing desde que se retiró panel.purgito.app.
DASHBOARD_BASE_URL=https://purgito.app

# URL pública de la landing. Destino del redirect post-login cuando el
# usuario inició sesión desde la landing (/auth/login?from=landing).
LANDING_URL=https://purgito.app

# Orígenes que pueden hacer requests autenticadas (con cookies) a la app,
# separados por coma. Con todo bajo purgito.app las llamadas son same-origin y
# no necesitan CORS; queda www porque sigue resolviendo al mismo servidor.
LANDING_ORIGINS=https://www.purgito.app

# Dominio de la cookie de sesión. Se queda en .purgito.app (y no vacío) para
# que www.purgito.app comparta la sesión con el apex; vacío en desarrollo local
# (cookie atada solo al host que la emite, comportamiento clásico).
SESSION_COOKIE_DOMAIN=.purgito.app

# Links del navbar/footer del panel rediseñado (/es/perfil, /es/dashboard/:id).
# SUPPORT_URL: invitación al servidor de soporte de Discord (cámbiala por el
# link real de invite cuando exista). DOCS_URL: documentación pública.
SUPPORT_URL=https://purgito.app
DOCS_URL=https://purgito.app/docs
REPO_URL=https://github.com/punkyyy01/bot-discord-purg
