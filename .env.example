# Copia este archivo a .env y pon tus credenciales
# NO coloques tokens reales aquí; usa .env (este archivo es público)
#
# Variables OBLIGATORIAS: DISCORD_TOKEN
# Variables OPCIONALES: todo lo demás tiene valores por defecto o fallback

# ── Obligatorio ──────────────────────────────────────────────────────────────

# Token del bot de Discord
DISCORD_TOKEN=tu-token-de-bot-aqui

# ── Intents ───────────────────────────────────────────────────────────────────

# Habilitar lectura de contenido de mensajes (requiere habilitarlo en el Developer Portal)
ENABLE_MESSAGE_CONTENT=true

# ── Desarrollo ────────────────────────────────────────────────────────────────

# ID del servidor para sync instantáneo de slash commands (opcional)
# Sin esto, los comandos tardan hasta 1 hora en propagarse globalmente
GUILD_ID=tu-id-de-servidor

# ── Comportamiento del bot ────────────────────────────────────────────────────

# Nombre con el que se activa el trigger de memes por texto (ej: "purgito generar")
# Fallback: purgito
BOT_TRIGGER_NAME=purgito

# [DEPRECADA] ID del servidor home original. Se lee UNA sola vez al arrancar para migrar
# el guild a la tabla premium_guilds. Después de la primera ejecución ya no tiene efecto.
# Reemplazada por el sistema premium, gestionado desde el panel de administración del dashboard.
HOME_GUILD_ID=

# ID de Discord del dueño del bot. Usado por el panel de administración del
# dashboard para gestionar los servidores premium.
# Ejemplo: BOT_OWNER_ID=123456789012345678
BOT_OWNER_ID=

# ── Opcional — IA para captions de memes ─────────────────────────────────────

# Groq API Key — para captions de memes con IA (fallback a Markov si no está)
GROQ_API_KEY=tu-groq-api-key

# ── Límites de importación de historial (corpus) ─────────────────────────────

# /refeed: máximo de mensajes a leer del canal actual
REFEED_MAX_MESSAGES=80000
# /refeed_all: máximo de mensajes a leer por canal
REFEED_ALL_MAX_MESSAGES=20000

# ── Markov (muestra de entrenamiento) ─────────────────────────────────────────

# Evita cargar todo el corpus a RAM. Se entrena con un muestreo aleatorio.
MARKOV_TRAINING_MESSAGES=5000
USER_MARKOV_TRAINING_MESSAGES=2000

# Probabilidad (0.0-1.0) de que el bot hable espontáneamente cuando el canal
# acumula suficientes mensajes nuevos. 1.0 = siempre (comportamiento antiguo).
AUTO_GENERATE_PROBABILITY=0.6

# ── Límites de almacenamiento por servidor ────────────────────────────────────
# Estos límites viven en limits.env (no en .env), porque no son sensibles y se
# versionan en git. Ver limits.env en la raíz del repo.

# ── Limpieza de datos al salir de un servidor ─────────────────────────────────

# Días de gracia antes de purgar todos los datos de un server del que el bot fue expulsado.
# Durante este período, si el bot es reinvitado los datos se conservan.
GUILD_DATA_RETENTION_DAYS=30

# Días que se conserva una entrada de audit_log (quién cambió qué desde el
# dashboard) antes de purgarse. Más largo que GUILD_DATA_RETENTION_DAYS a
# propósito -- es un registro de auditoría, no el dato en sí -- pero acotado:
# el campo "detail" puede llevar texto tal cual escrito por un admin (ej. el
# texto completo de una frase especial), así que no debe retenerse para siempre.
AUDIT_LOG_RETENTION_DAYS=90

# ── Opcional — almacenamiento de GIFs e imágenes (Cloudflare R2) ─────────────
# Si no se configuran, las URLs de Discord CDN se guardan tal cual
# (pueden expirar cuando Discord elimine el adjunto original).
# Todas las variables deben estar presentes para que R2 se active.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Web API (gestión de GIFs via HTTP) ───────────────────────────────────────
# Puerto donde escucha la API REST pública. Se inicia junto con el bot.
WEB_PORT=8080

# ── Dashboard web (Discord OAuth2) ────────────────────────────────────────────

# Credenciales de la app de Discord (Developer Portal → OAuth2).
# DISCORD_CLIENT_ID es público (aparece en cualquier link de invitación),
# pero se guarda acá igual por conveniencia.
DISCORD_CLIENT_ID=

# Developer Portal → OAuth2 → Reset Secret. Este SÍ es secreto.
DISCORD_CLIENT_SECRET=

# Clave random para cifrar las cookies de sesión del dashboard. Generarla con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Por defecto el dashboard se habilita solo con que SESSION_SECRET tenga un
# valor (ver DASHBOARD_ENABLED en config.py). Descomentá la línea de abajo
# para forzarlo apagado sin borrar las credenciales de arriba — OJO: dejarla
# descomentada pero vacía ("DASHBOARD_ENABLED=") también lo apaga, porque
# _env_bool trata "" como valor presente, no como ausente.
# DASHBOARD_ENABLED=false

# Las URLs del dashboard/landing (PANEL_URL, DASHBOARD_BASE_URL, LANDING_URL,
# LANDING_ORIGINS, SESSION_COOKIE_DOMAIN) viven en urls.env, no acá — no son
# secretos y se versionan en git. Ver urls.env en la raíz del repo.

# ── Opcional — Polar.sh (compra de premium desde el panel) ──────────────────
# Si POLAR_ACCESS_TOKEN no está, el checkout queda deshabilitado (el resto del bot funciona igual).

# Token de acceso de la organización en Polar (Settings → Developers)
POLAR_ACCESS_TOKEN=
# Secret del webhook configurado en Polar apuntando a /webhooks/polar
POLAR_WEBHOOK_SECRET=
# "sandbox" (pruebas) o "production". Default: sandbox
POLAR_SERVER=sandbox
# ID del producto de suscripción mensual en Polar
POLAR_PRODUCT_ID_MONTHLY=
# ID del producto de suscripción anual en Polar
POLAR_PRODUCT_ID_ANNUAL=

# ── Anuncios programados ──────────────────────────────────────────────────────

# Timezone usada para el modo "hora fija" de /settings > Anuncios (IANA tz database).
ANNOUNCEMENTS_TIMEZONE=America/Santiago
