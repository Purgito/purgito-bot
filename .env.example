# Copia este archivo a .env y pon tus credenciales
# NO coloques tokens reales aquí; usa .env (este archivo es público)
#
# Variables OBLIGATORIAS: DISCORD_TOKEN, DATABASE_URL
# Variables OBLIGATORIAS SI QUERÉS EL DASHBOARD WEB: DISCORD_CLIENT_ID,
#   DISCORD_CLIENT_SECRET, SESSION_SECRET (ver sección "Dashboard web" más
#   abajo — sin ellas el bot arranca igual, sin ningún error visible)
# Variables OPCIONALES: todo lo demás tiene valores por defecto o fallback

# ── Obligatorio ──────────────────────────────────────────────────────────────

# Token del bot de Discord
DISCORD_TOKEN=tu-token-de-bot-aqui

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# Obligatoria. Ver docs/POSTGRES.md para crear el usuario y la base.
DATABASE_URL=postgresql://purgito_app:clave@127.0.0.1:5432/purgito
# Solo para correr los tests: una base DISTINTA, los tests la vacían.
# TEST_DATABASE_URL=postgresql://purgito_app:clave@127.0.0.1:5432/purgito_test
# Tamaño del pool de conexiones (opcional)
# DB_POOL_MIN=2
# DB_POOL_MAX=10

# ── Intents ───────────────────────────────────────────────────────────────────

# Habilitar lectura de contenido de mensajes (requiere habilitarlo en el Developer Portal)
ENABLE_MESSAGE_CONTENT=true

# ── Desarrollo ────────────────────────────────────────────────────────────────

# ID del servidor para sync instantáneo de slash commands (opcional)
# Sin esto, los comandos tardan hasta 1 hora en propagarse globalmente
GUILD_ID=tu-id-de-servidor

# ── Comportamiento del bot ────────────────────────────────────────────────────

# Nombre con el que se activa el trigger de memes por texto (ej: "purgito generar")
# y el prefijo de palabra de los comandos de texto (ej: "purgito dl <link>",
# ver cogs/download.py y bot.py:get_prefix). Fallback: purgito
BOT_TRIGGER_NAME=purgito

# Canal donde Purgito avisa cuando arranca/se apaga y cuando una tarea en segundo
# plano falla varias veces seguidas. Sin definir usa el canal del proyecto; vacío
# o 0 apaga los avisos (útil en una instancia de desarrollo).
# LIFECYCLE_ANNOUNCE_CHANNEL_ID=

# [DEPRECADA] ID del servidor home original. Se lee UNA sola vez al arrancar para migrar
# el guild a la tabla premium_guilds. Después de la primera ejecución ya no tiene efecto.
# Reemplazada por el sistema premium, gestionado desde el panel de administración del dashboard.
HOME_GUILD_ID=

# ID de Discord del dueño del bot. Usado por el panel de administración del
# dashboard para gestionar los servidores premium.
# Ejemplo: BOT_OWNER_ID=123456789012345678
BOT_OWNER_ID=

# ── Opcional — IA para captions de memes ─────────────────────────────────────

# Groq API Key — para captions de memes con IA (fallback a Markov si no está)
GROQ_API_KEY=tu-groq-api-key

# ── Opcional — avisos de Twitch en vivo ───────────────────────────────────────

# Client ID y Client Secret de una app registrada en
# https://dev.twitch.tv/console/apps (grant type "Client Credentials", no
# necesita OAuth Redirect URL real). Sin estas dos, la categoría de Twitch
# de /settings y del dashboard queda visible pero no deja agregar canales
# -- el resto del bot funciona igual.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Opcional — respaldo de !dl con cobalt ─────────────────────────────────────

# URL de TU instancia de cobalt (autoalojada, normalmente en loopback). Cuando
# yt-dlp no logra bajar un link, !dl lo intenta ahí. Sin definir, !dl funciona
# igual, solo con yt-dlp. NO apuntar a api.cobalt.tools: no admite bots sin
# permiso. Instalación en DEPLOY.md § "cobalt (respaldo de !dl)".
# COBALT_API_URL=http://127.0.0.1:9000
# Solo si esa instancia exige autenticación (API_AUTH_REQUIRED=1).
# COBALT_API_KEY=

# ── Límites, corpus, Markov y retención de datos ──────────────────────────────
# Viven en limits.env (no en .env): no son sensibles y se versionan en git.
# Incluye REFEED_*, MARKOV_TRAINING_MESSAGES, USER_MARKOV_TRAINING_MESSAGES,
# GUILD_DATA_RETENTION_DAYS, AUDIT_LOG_RETENTION_DAYS y todos los MAX_*.
# La probabilidad de hablar espontáneamente es por servidor (tab CHAT del
# dashboard, tabla settings); AUTO_GENERATE_PROBABILITY ya no va en .env.
# Las URLs públicas (PANEL_URL, LANDING_URL, etc.) viven en urls.env.

# ── Opcional — almacenamiento en Cloudflare R2 (3 buckets) ───────────────────
# Si no se configuran, las URLs de Discord CDN se guardan tal cual
# (pueden expirar cuando Discord elimine el adjunto original) y los backups
# de bot.db quedan solo en el disco del servidor.
#
# Son TRES buckets, cada uno con un rol fijo:
#   imágenes  (público)  memes y subidas del editor de embeds
#   GIFs      (público)  GIFs content-addressed (gifs/xx/<sha256>.gif)
#   backups   (PRIVADO)  copias de bot.db -- sin URL pública, nunca
# Las mismas credenciales sirven para los tres: el token de R2 necesita
# "Object Read & Write" sobre cada uno (DEPLOY.md § Cloudflare R2).

# SECRETAS -- solo en .env, nunca en un archivo versionado:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Endpoint de la CUENTA (https://<ACCOUNT_ID>.r2.cloudflarestorage.com).
# No es secreto, pero tampoco se publica. NO lleva el nombre de ningún bucket.
R2_ENDPOINT_URL=

# Bucket de imágenes. El nombre no es secreto; la URL pública (la que
# Cloudflare muestra al activar el acceso público, https://pub-xxx.r2.dev o un
# dominio propio) tampoco: es la que termina guardada en la DB y en Discord.
R2_IMAGES_BUCKET=purgito-images
R2_IMAGES_PUBLIC_URL=

# Bucket de GIFs. Mismas reglas que el de imágenes, con su propia URL pública.
R2_GIFS_BUCKET=purgito-gifs
R2_GIFS_PUBLIC_URL=

# Bucket de backups. PRIVADO: no hay R2_BACKUP_PUBLIC_URL porque no puede
# haberla -- no le actives Public Development URL ni le conectes un dominio.
# Lo usa deploy/backup_db.sh (cron); el bot no lo lee.
R2_BACKUP_BUCKET=purgito-backups

# Esquema viejo (un solo bucket: R2_BUCKET_NAME y R2_PUBLIC_URL). Ya no se
# declaran acá. Mientras sigan definidas en tu .env, el bot las usa como
# fallback transitorio y avisa al arrancar; se borran al terminar la
# migración (DEPLOY.md § Migrar a tres buckets de R2).

# ── Web API (gestión de GIFs via HTTP) ───────────────────────────────────────
# Puerto donde escucha la API REST pública. Se inicia junto con el bot.
WEB_PORT=8080

# ── Dashboard web (Discord OAuth2) ────────────────────────────────────────────
# Las tres variables de abajo (DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET,
# SESSION_SECRET) son OBLIGATORIAS si querés que el dashboard funcione. Sin
# ellas el bot arranca igual y no tira ningún error — solo un log.warning
# "Dashboard deshabilitado: faltan variables obligatorias ..." al arrancar
# (ver DASHBOARD_ENABLED en config.py), y cualquiera que intente loguearse
# al panel se encuentra con un 404 sin explicación.

# Credenciales de la app de Discord (Developer Portal → OAuth2).
# DISCORD_CLIENT_ID es público (aparece en cualquier link de invitación),
# pero se guarda acá igual por conveniencia.
DISCORD_CLIENT_ID=

# Developer Portal → OAuth2 → Reset Secret. Este SÍ es secreto.
DISCORD_CLIENT_SECRET=

# Clave random para cifrar las cookies de sesión del dashboard. Generarla con:
# python3 -c "import secrets; print(secrets.token_hex(32))"
# Mínimo recomendado: 32 caracteres (con menos, el bot avisa al arrancar).
SESSION_SECRET=

# Por defecto el dashboard se habilita solo con que SESSION_SECRET tenga un
# valor (ver DASHBOARD_ENABLED en config.py). Descomentá la línea de abajo
# para forzarlo apagado sin borrar las credenciales de arriba — OJO: dejarla
# descomentada pero vacía ("DASHBOARD_ENABLED=") también lo apaga, porque
# _env_bool trata "" como valor presente, no como ausente.
# DASHBOARD_ENABLED=false

# Las URLs del dashboard/landing (PANEL_URL, DASHBOARD_BASE_URL, LANDING_URL,
# LANDING_ORIGINS, SESSION_COOKIE_DOMAIN) viven en urls.env, no acá — no son
# secretos y se versionan en git. Ver urls.env en la raíz del repo.

# ── Opcional — Polar.sh (compra de premium desde el panel) ──────────────────
# Si POLAR_ACCESS_TOKEN no está, el checkout queda deshabilitado (el resto del bot funciona igual).

# Token de acceso de la organización en Polar (Settings → Developers)
POLAR_ACCESS_TOKEN=
# Secret del webhook configurado en Polar apuntando a /webhooks/polar
POLAR_WEBHOOK_SECRET=
# "sandbox" (pruebas) o "production". Default: sandbox
POLAR_SERVER=sandbox
# ID del producto de suscripción mensual en Polar
POLAR_PRODUCT_ID_MONTHLY=
# ID del producto de suscripción anual en Polar
POLAR_PRODUCT_ID_ANNUAL=

# ── Anuncios programados ──────────────────────────────────────────────────────

# Timezone usada para el modo "hora fija" de /settings > Anuncios (IANA tz database).
ANNOUNCEMENTS_TIMEZONE=America/Santiago

# Clave(s) PÚBLICA(S) de age con las que deploy/backup_db.sh cifra los backups
# antes de subirlos a R2 (age1..., varias separadas por espacio o coma). La clave
# PRIVADA no va en el servidor: ver docs/POSTGRES.md § Backups.
BACKUP_AGE_RECIPIENTS=

# --- Observabilidad (docs/OBSERVABILITY.md) ---
# Bearer para /metrics, /health/details e /internal/alerts (solo accesibles por
# 127.0.0.1 / SSH / Tailscale; nginx no los publica). Vacío = esos endpoints
# no existen. Generar con: openssl rand -hex 32
OBSERVABILITY_TOKEN=
# --- Monitor externo (purgito-monitor en Railway; docs/OBSERVABILITY.md) ---
# Opcional. Con MONITOR_ENABLED=false (o cualquier variable vacía) Purgito no
# envía nada y funciona igual. Nunca commitees el secreto.
MONITOR_ENABLED=false
MONITOR_BASE_URL=            # https://<servicio>.up.railway.app (http solo en loopback)
MONITOR_NODE_ID=             # estable, p. ej. purgito-prod-01; NO el hostname
MONITOR_SHARED_SECRET=       # openssl rand -hex 32; el mismo valor en Railway
MONITOR_HEARTBEAT_INTERVAL=30
# Etiqueta "environment" de los eventos (production | staging | dev).
PURGITO_ENV=production
