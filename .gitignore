# Python
__pycache__/
*.pyc
*.pyo

# Virtual environment
.venv/
venv/

# Env files
.env
.env.*
!.env.example

# Editor
.vscode/
.idea/

# Claude Code: plugins/skills instalados localmente (/plugin), no config del
# proyecto -- se reinstalan solos, no hace falta versionarlos.
.claude/

# Todo lo generado en runtime dentro de data/ (DB + sidecars de WAL, logs
# rotados, flags de migración, backups ad-hoc con nombre arbitrario) --
# antes solo cubría data/*.db y *.log, que no alcanzan a bot.db-shm/-wal
# (sufijo distinto de .db), bot.log.1/.log.2 (*.log no matchea sufijos
# numéricos) ni a bot.db.bak-<fecha> (*.bak exige que el nombre TERMINE en
# .bak). Confirmado real en el droplet: esos cuatro tipos de archivo
# aparecían como untracked en `git status`, a un `git add -A` de terminar
# commiteados a un repo público. data/.gitkeep es la única excepción.
data/*
!data/.gitkeep

# Logs (fuera de data/, si los hubiera)
*.log
*.out
*.err

# OS generated files
.DS_Store
Thumbs.db

# Test / coverage
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter Notebooks
.ipynb_checkpoints/

# Graphify
graphify-out/
raw/

# Generated docs
TECHNICAL_DOC.md
repomix-output.xml

# Dumps de código externo usados solo como referencia visual/técnica.
# No son parte del proyecto: no se versionan.
referencias/

# Backup files
*.bak

# Node.js artifacts (not a Node project)
package-lock.json

# Fuente de edición de video: 28 MB que git no comprime ni diffea. Sigue en
# disco, solo deja de versionarse. El .mov corto de material-homepague sí
# está trackeado, por eso la ruta va exacta y no un *.mov general.
design/material-homepague/video_para_davinci.mov