# Comprueba (solo lectura) que existe un backup de menos de 26 h y una instantánea del registro de menos de 1 h;
# si no, avisa por BACKUP_ALERT_WEBHOOK. Lo lanza purgito-backup-check.timer cada 6 h.
[Unit]
Description=Vigilancia de backups y registro de Purgito (dead-man)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=purgito_backup
Group=purgito_backup
EnvironmentFile=/etc/purgito/backup.env
WorkingDirectory=/var/backups/purgito
ExecStart=/opt/purgito-backup/deploy/backup_check.sh
StandardOutput=append:/var/backups/purgito/check.log
StandardError=append:/var/backups/purgito/check.log
UMask=0077
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
MemoryMax=128M

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/purgito
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
