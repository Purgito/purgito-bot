# Backup de la base de Purgito (generación 2). Lo lanza el timer purgito-backup.timer (o a
# mano: sudo systemctl start purgito-backup.service). Corre como un usuario propio, sin
# acceso al .env ni a los archivos del bot, con las credenciales de R2 que solo systemd lee
# de /etc/purgito/backup.env (root:root 0600). El código sale de /opt/purgito-backup (root).
[Unit]
Description=Backup cifrado de la base de Purgito (gen2)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=purgito_backup
Group=purgito_backup
EnvironmentFile=/etc/purgito/backup.env
WorkingDirectory=/var/backups/purgito
ExecStart=/opt/purgito-backup/deploy/backup_db.sh
StandardOutput=append:/var/backups/purgito/backup.log
StandardError=append:/var/backups/purgito/backup.log
UMask=0077
TimeoutStartSec=30min
# Guardas de backup_guard.sh (exclusión mutua, 12 h mínimas entre copias, origen en el log).
# Código 75 = "omitida a propósito" (otra copia en curso o una reciente): no es un fallo y no avisa.
Environment=BACKUP_REQUIRE_GUARD=1
SuccessExitStatus=75
Nice=10
IOSchedulingClass=idle
MemoryMax=768M

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/purgito
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
