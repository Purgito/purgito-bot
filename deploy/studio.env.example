# Entorno del servicio studio-purg. Instalar como /etc/purgito/studio.env (root:root, 0600).
# NO es el .env del bot: aquí solo va lo que el panel necesita. Nunca versionar el real.
#
# --- Acceso de servicio al backend del bot (127.0.0.1) ---
# Mismo valor que OBSERVABILITY_TOKEN del .env del bot. El navegador nunca lo recibe.
OBSERVABILITY_TOKEN=<copiar con el comando de docs/STUDIO_ACCESS.md, sin mostrarlo>
WEB_PORT=8080

# --- Acceso remoto por Cloudflare Access (opcional; las cuatro o ninguna) ---
# Equipo de Zero Trust: <equipo>.cloudflareaccess.com
STUDIO_ACCESS_TEAM=
# Etiqueta AUD (64 hex) de la aplicación de Access «Purgito Studio»
STUDIO_ACCESS_AUD=
# Nombre de host público del panel
STUDIO_PUBLIC_HOST=studio.purgito.app
# Correos autorizados, separados por comas. Defensa en profundidad: Access ya filtra por política,
# y el panel vuelve a comprobarlo contra esta lista.
STUDIO_ACCESS_EMAILS=
