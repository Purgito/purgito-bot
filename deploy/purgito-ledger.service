# Exporta, cifrada con age, la instantánea del registro de eliminaciones y exclusiones a
# gen2/ledger/ de R2 y poda las instantáneas vencidas (> 15 días; siempre quedan las 3 últimas).
# Lo lanza purgito-ledger.timer cada 5 minutos. Mismo usuario aislado y mismo sandbox que el backup.
[Unit]
Description=Registro externo de eliminaciones de Purgito (gen2/ledger)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=purgito_backup
Group=purgito_backup
EnvironmentFile=/etc/purgito/backup.env
WorkingDirectory=/var/backups/purgito
ExecStart=/opt/purgito-backup/deploy/export_ledger.sh
StandardOutput=append:/var/backups/purgito/ledger.log
StandardError=append:/var/backups/purgito/ledger.log
UMask=0077
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
MemoryMax=256M

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups/purgito
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
