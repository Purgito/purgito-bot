# ── Límites de almacenamiento por servidor ────────────────────────────────────
# A diferencia de .env, este archivo NO contiene secretos y SÍ se versiona en
# git (no está en .gitignore). Para ajustar un límite: editar, commitear, y en
# el servidor `git pull` + reiniciar el bot — sin tocar el .env manualmente.

# Máximo de mensajes en corpus_messages POR CANAL (se purgan los más viejos de
# ese canal). No es un tope de guild: cada canal tiene su propia cuota, así un
# canal con mucho historial no desplaza el corpus de los demás canales.
MAX_CORPUS_MESSAGES_PER_GUILD_FREE=15000
MAX_CORPUS_MESSAGES_PER_GUILD_PREMIUM=50000

# Red de seguridad adicional sobre el tope por canal de arriba: tope sobre el
# TOTAL de corpus_messages de un guild (todos los canales sumados), para
# guilds con muchos canales activos donde la suma podría crecer sin límite
# real. Recorte water-filling (nunca "más antiguo global"): si se supera,
# cada canal por encima de un umbral común se recorta a ese umbral; los
# canales ya chicos no pierden nada. Ver trim_guild_total_if_needed en db.py.
MAX_CORPUS_MESSAGES_PER_GUILD_TOTAL_FREE=150000
MAX_CORPUS_MESSAGES_PER_GUILD_TOTAL_PREMIUM=500000

# Máximo de mensajes en user_corpus POR AUTOR (se purgan los más viejos de
# ese autor). No es un tope de guild: un autor muy activo no desplaza el
# corpus de otros autores del mismo servidor. Menor que el cupo por canal de
# corpus_messages porque el estilo de una sola persona satura con bastante
# menos texto que el corpus completo de un canal.
MAX_USER_CORPUS_MESSAGES_PER_GUILD_FREE=2000
MAX_USER_CORPUS_MESSAGES_PER_GUILD_PREMIUM=8000

# Máximo de GIFs por guild. Al llegar al límite se descarta el más viejo (y se borra de R2 si aplica).
MAX_GIFS_PER_GUILD_FREE=1500
MAX_GIFS_PER_GUILD_PREMIUM=4000

# Tamaño máximo de un GIF para subirlo a R2 (en bytes). Default: 8 MB.
# Si el GIF supera este tamaño no se sube a R2 NI se guarda en corpus_gifs.
MAX_GIF_DOWNLOAD_BYTES=8388608

# Compresión con pérdida de gifsicle al subir un GIF a R2 (--lossy=N).
# Más alto = archivos más chicos y peor calidad. 0 desactiva la pérdida pero
# deja la optimización sin pérdida (--optimize=3). Rango útil: 20-80.
# Si gifsicle no está instalado el GIF se sube sin optimizar (ver DEPLOY.md).
GIF_LOSSY_LEVEL=30

# Máximo de imágenes en el pool de memes por guild.
MAX_IMAGES_PER_GUILD_FREE=75
MAX_IMAGES_PER_GUILD_PREMIUM=200

# Máximo de frases especiales guardadas por guild (tab CHAT → Frases del
# dashboard). Al llegar al límite, add_frase_especial rechaza el alta.
MAX_FRASES_PER_GUILD_FREE=50
MAX_FRASES_PER_GUILD_PREMIUM=200

# Máximo de packs de frases por guild (agrupan frases para asignarles un pool
# distinto a cada canal). Al llegar al límite, add_frase_pack rechaza el alta.
MAX_FRASE_PACKS_PER_GUILD_FREE=5
MAX_FRASE_PACKS_PER_GUILD_PREMIUM=20

# Máximo de triggers de auto-respuesta por guild (suma de todos los canales).
# Cada uno corre una evaluación más por mensaje en su canal (una de tipo
# regex, con timeout real -- ver _handle_trigger en cogs/chat.py), así que
# el tope cuida CPU tanto como espacio en la DB.
MAX_CHANNEL_TRIGGERS_PER_GUILD_FREE=10
MAX_CHANNEL_TRIGGERS_PER_GUILD_PREMIUM=30

# Máximo de anuncios programados por guild (suma de ambos modos, intervalo + hora fija).
# Al llegar al límite, add_scheduled_announcement rechaza el alta (no se evictan anuncios viejos).
MAX_ANNOUNCEMENTS_PER_GUILD_FREE=3
MAX_ANNOUNCEMENTS_PER_GUILD_PREMIUM=10

# Máximo de plantillas de embed guardadas por guild (editor de embeds del panel).
# Solo limita las plantillas GUARDADAS: crear y enviar embeds es gratis para todos.
# Al llegar al límite, add_embed_template rechaza el alta (no se evicta la más vieja).
MAX_EMBED_TEMPLATES_PER_GUILD_FREE=20
MAX_EMBED_TEMPLATES_PER_GUILD_PREMIUM=50

# Tamaño máximo (bytes) de una imagen subida desde el editor de embeds del panel
# (botón "Subir archivo" / pegar del portapapeles). Default: 8 MB, igual que GIFs.
MAX_EMBED_IMAGE_UPLOAD_BYTES=8388608

# Máximo de links de embed compartido ("Compartir" del editor) generados por
# guild por día (UTC). Evita usar el share como storage gratis de terceros.
# Los links duran 7 días (SHARED_EMBED_TTL_DAYS en db.py) y se limpian solos.
MAX_SHARE_LINKS_PER_GUILD_DAY=20

# Distancia de Hamming máxima entre dos phash (dHash) de GIFs para considerarlos
# el mismo meme y fusionarlos sin subir un objeto nuevo a R2 (dedup perceptual,
# complementa el dedup exacto por content_hash). Punto de partida conservador:
# HAY que ajustarlo mirando el reporte de clusters de
# scripts/backfill_gif_phashes.py en modo dry-run antes de confiar en el
# auto-merge -- un umbral mal calibrado puede fusionar memes que en realidad
# son distintos.
GIF_PHASH_MAX_DISTANCE=6
