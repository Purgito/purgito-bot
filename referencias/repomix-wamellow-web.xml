                        >
                            <AiOutlineEdit className="w-6 h-6 text-white/80" />
                        </motion.div>
                    )}
                </AnimatePresence>
            </label>

            {description && (
                <div className="dark:text-neutral-500 text-neutral-400 text-sm mt-1">
                    {description}
                </div>
            )}
        </div>
