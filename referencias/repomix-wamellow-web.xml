export function generateHourArray(date: Date) {
    const hoursArray = [];

    for (let hour = 0; hour < 24; hour++) {
        hoursArray.push({
            name: `${((hour + 11) % 12 + 1)}${hour < 12 ? "am" : "pm"}`,
            value: (hour + Math.floor(date.getTimezoneOffset() / 60) + 24) % 24
        });
    }

    return hoursArray;
}
